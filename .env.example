# Copiá este archivo como .env y completá con los datos de tu proyecto de Firebase.
# Consola de Firebase > Configuración del proyecto > Tus apps > Configuración del SDK.
# Estos valores son públicos por diseño (viajan en el bundle): lo que protege la base
# son las reglas de database.rules.json, no estas claves.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Poné true para desarrollar contra el emulador local (npm run emulador).
# En ese caso los valores de arriba pueden ser cualquier cosa, pero tienen que estar.
VITE_USAR_EMULADOR=false
